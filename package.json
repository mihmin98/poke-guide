{
  "name": "poke-guide",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "lint": "ng lint",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "theme:games": "tsx scripts/theme/generate-game-themes.ts",
    "fonts": "tsx scripts/fonts/fonts.ts",
    "icons": "tsx scripts/icons/generate-icons.ts",
    "data:fixtures": "tsx scripts/data/capture-fixtures.ts --group rby",
    "data:build": "tsx scripts/data/build.ts --group rby",
    "data:build:all": "tsx scripts/data/build.ts --all",
    "data:refresh": "tsx scripts/data/build.ts --group rby --refresh",
    "data:offline": "tsx scripts/data/build.ts --group rby --offline",
    "data:sprites": "tsx scripts/data/sprites.ts --group rby",
    "verify": "npm run theme:games -- --check && npm run fonts -- --check && npm run lint && npm run typecheck:scripts && npm run test:scripts && npm run test:ci && ng build"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.6",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.6",
    "qrcode-generator": "^2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@material/material-color-utilities": "^0.4.0",
    "@types/node": "^26.5.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "fast-check": "^4.10.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8",
    "zod": "^4.6.2"
  }
}
