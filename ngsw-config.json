{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": { "version": "1.2.0" },
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon.svg",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/media/**"
        ]
      }
    },
    {
      "name": "game-data",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/data/**"] }
    },
    {
      "name": "images",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": { "files": ["/sprites/**", "/icons/**"] }
    }
  ]
}
